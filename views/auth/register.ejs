<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/header', { title: 'Inscription — AZÔÔDIÉ' }) %>
</head>
<body>


    <%- include('../partials/nav') %>
    <div class="form-container">
        <h1>Créer un compte</h1>

        <% if (errors.length > 0) { %> 
            <div style="background: #FBE7E4; color:#C0392B; padding:12px; border-radius: 10px; margin-bottom:16px;">
                <ul style="margin:0; padding-left:18px;">
                    <% errors.forEach(function(err) { %>
                        <li><%= err.msg %></li>
                    <% }); %>
                </ul>

            </div>
        <% } %>

         <form action="/register" method="POST">

            <div class="form-group">
                <label for="name">Nom</label>
                <input type="text" id="name" name="name" required>
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
                <label for="password"> Mot de passe</label>
                <input type="password" id="password" name="password" required minlength="8">
            </div>

            <div class="form-group">
                  <label for="role">Je suis</label>
                  <select name="role" id="role">
                    <option value="client">Un client</option>
                    <option value="professional">Un professionnel</option>

                  </select>

            </div>

            <button type="submit" class="btn-primary">S'inscrire</button>
         </form>
    </div>  
</body>
</html>