<!DOCTYPE html>
<html lang="fr">
<head>
     <%- include('../partials/header', { title: 'Connexion — AZÔÔDIÉ' }) %>
</head>
<body>

    <%- include('../partials/nav') %>


    <div class="form-container">
        <h1>Se connecter</h1>

        <% if(errors.length > 0) { %>
            <div style="background: #FBE7E4; color:#C0392B; padding:12px; border-radius:10px; margin-bottom:16px;">
                <ul style="margin: 0; padding-left:18px;">
                   <% errors.forEach(function(err) { %>
                     <li><%= err.msg %></li>
                
                
                   <% }); %>

                </ul>
            </div>
        <%  }  %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" name="email" id="email" required>
            </div>

            <div class="form-group">
    <label for="password">Mot de passe</label>
      <div style="position:relative;">
        <input type="password" id="password" name="password" required style="padding-right:44px; width: 417px;">
        <button type="button" data-password-toggle="password" aria-label="Afficher le mot de passe" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:4px; display:flex;">
            <svg id="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
            </svg>
        </button>
      </div>
    </div>
            
            <button type="submit" class="btn-primary"> Se connecter</button>

        </form>

        <p style="margin-top: 16px; text-align: center;">

            <a href="/register" style="color:var(--teal);"> Créer un compte</a>
        </p>


    </div>

    <script src="/js/password-toggle.js"></script>
    
</body>
</html>