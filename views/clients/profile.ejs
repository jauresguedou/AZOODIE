<%
    const openAnnouncementCount = announcements.filter((announcement) => announcement.status === "open").length;
    const memberSince = user.created_at
        ? new Intl.DateTimeFormat("fr-FR", { month: "long", year: "numeric" }).format(new Date(user.created_at))
        : null;
%>
<div class="profile-page">
    <section class="profile-card profile-identity" aria-labelledby="profile-name">
        <div class="profile-cover" aria-hidden="true">
            <span class="profile-cover-mark">AZÔÔDIÉ</span>
        </div>

        <div class="profile-identity-content">
            <div class="profile-avatar-wrap">
                <% if (user.photo_url) { %>
                    <img class="profile-avatar" src="<%= user.photo_url %>" alt="Photo de profil de <%= user.name %>">
                <% } else { %>
                    <div class="profile-avatar profile-avatar-placeholder" role="img" aria-label="Initiale de <%= user.name %>">
                        <%= user.name.trim().charAt(0).toLocaleUpperCase("fr-FR") %>
                    </div>
                <% } %>
                <form id="profile-photo-form" class="profile-photo-editor" action="/profile/photo" method="POST" enctype="multipart/form-data">
                    <label class="profile-photo-edit" aria-label="Modifier la photo de profil">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20h9"></path>
                            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                        </svg>
                        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" aria-label="Choisir une nouvelle photo de profil">
                    </label>
                </form>
            </div>

            <div class="profile-identity-details">
                <div>
                    <p class="profile-eyebrow">Espace personnel</p>
                    <h1 id="profile-name"><%= user.name %></h1>
                    <p class="profile-contact"><%= user.email %></p>
                    <% if (memberSince) { %>
                        <p class="profile-meta">Membre depuis <%= memberSince %></p>
                    <% } %>
                </div>

                <a class="profile-action-link" href="/professionals" aria-label="Découvrir les professionnels">
                    Découvrir les professionnels
                </a>
            </div>
        </div>
    </section>

    <div class="profile-columns">
        <section class="profile-card profile-activity" aria-labelledby="activity-heading">
            <div class="profile-section-heading">
                <div>
                    <p class="profile-eyebrow">Votre activité</p>
                    <h2 id="activity-heading">Mes annonces</h2>
                </div>
                <span class="profile-count"><%= announcements.length %></span>
            </div>

            <% if (announcements.length === 0) { %>
                <div class="profile-empty-state">
                    <span class="profile-empty-icon" aria-hidden="true">+</span>
                    <h3>Votre activité commence ici</h3>
                    <p>Publiez une demande pour la retrouver facilement et suivre son évolution depuis votre profil.</p>
                    <a href="/professionals" class="profile-action-link">Trouver un professionnel</a>
                </div>
            <% } else { %>
                <div class="profile-announcements">
                    <% announcements.forEach(function(announcement) { %>
                        <article class="profile-announcement">
                            <div class="profile-announcement-icon" aria-hidden="true">
                                <%= announcement.category.trim().charAt(0).toLocaleUpperCase("fr-FR") %>
                            </div>
                            <div class="profile-announcement-content">
                                <h3><%= announcement.category %></h3>
                                <p><%= announcement.description %></p>
                                <% if (announcement.address_text) { %>
                                    <span class="profile-announcement-location"><%= announcement.address_text %></span>
                                <% } %>
                            </div>
                            <span class="profile-status <%= announcement.status === 'open' ? 'profile-status-open' : 'profile-status-closed' %>">
                                <%= announcement.status === "open" ? "En cours" : "Terminée" %>
                            </span>
                        </article>
                    <% }); %>
                </div>
            <% } %>
        </section>

        <aside class="profile-sidebar" aria-label="Résumé du profil">
            <section class="profile-card profile-stat-card">
                <p class="profile-eyebrow">En un coup d'œil</p>
                <div class="profile-stat-row">
                    <span>Demandes publiées</span>
                    <strong><%= announcements.length %></strong>
                </div>
                <div class="profile-stat-row">
                    <span>Demandes en cours</span>
                    <strong><%= openAnnouncementCount %></strong>
                </div>
            </section>

            <p class="profile-privacy-note">Vos coordonnées de connexion restent privées et ne sont pas affichées aux professionnels.</p>
        </aside>
    </div>
</div>
<script src="/js/profile-photo.js" defer></script>
