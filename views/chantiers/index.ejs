<div class="chantiers-page">
    <div class="chantiers-layout" id="chantiers-layout">
        <aside class="chantiers-sidebar" aria-label="Actions des chantiers">
            <button
                type="button"
                class="chantiers-sidebar-toggle"
                id="chantiers-sidebar-toggle"
                aria-expanded="true"
                aria-controls="chantiers-sidebar-content"
                aria-label="Replier le menu des chantiers">
                <span class="chantiers-sidebar-toggle-icon" aria-hidden="true">☰</span>
                <span class="chantiers-sidebar-toggle-label">Replier le menu</span>
            </button>

            <div class="chantiers-sidebar-content" id="chantiers-sidebar-content">
                <p class="chantiers-sidebar-heading">Actions rapides</p>

                <button
                    type="button"
                    class="chantiers-sidebar-action chantiers-sidebar-invitations"
                    onclick="window.location.href='/chantiers/invitations'">
                    <span aria-hidden="true">✉</span>
                    <span>Mes invitations</span>
                </button>

                <button
                    type="button"
                    class="chantiers-sidebar-action chantiers-sidebar-create"
                    onclick="window.location.href='/chantiers/nouveau'">
                    <span aria-hidden="true"></span>
                    <span>Créer un chantier</span>
                </button>
            </div>
        </aside>

        <div class="chantiers-main">
            <div class="chantiers-header">
                <div>
                    <p class="chantiers-eyebrow">GESTION DE PROJETS</p>
                    <h1>Mes chantiers</h1>
                    <p class="chantiers-subtitle">
                        Organisez vos projets de construction et suivez leur avancement
                        depuis AZÔÔDIÉ.
                    </p>
                </div>
            </div>

        <% if (projects.length === 0) { %>
        <section class="chantiers-empty">
            <div class="chantiers-empty-icon"></div>
            <h2>Votre premier chantier commence ici</h2>
            <p>
                Créez votre projet pour centraliser son lieu, son budget
                prévisionnel et ses dates.
            </p>
            <button
                type="button"
                class="btn-primary"
                onclick="window.location.href='/chantiers/nouveau'">
                Créer mon premier chantier
            </button>
        </section>
    <% } else { %>
        <div class="chantiers-summary">
            <span>
                <strong><%= projects.length %></strong>
                <%= projects.length > 1 ? "chantiers" : "chantier" %>
            </span>
        </div>

        <div class="chantiers-grid">
            <% projects.forEach(function(project) { %>
                <article class="chantier-card">
                    <div class="chantier-card-top">
                        <span class="chantier-status chantier-status-<%= project.status %>">
                            <% const statusLabels = {
                                planning: "À planifier",
                                in_progress: "En cours",
                                paused: "En pause",
                                completed: "Terminé",
                                cancelled: "Annulé"
                            }; %>
                            <%= statusLabels[project.status] || project.status %>
                        </span>

                        <span class="chantier-access">
                            <% const accessLabels = {
                                owner: "Propriétaire",
                                site_manager: "Responsable",
                                viewer: "Lecture seule"
                            }; %>
                            <%= accessLabels[project.access_role] || "Membre" %>
                        </span>
                    </div>

                    <h2><%= project.title %></h2>

                    <% if (project.description) { %>
                        <p class="chantier-description"><%= project.description %></p>
                    <% } %>

                    <div class="chantier-details">
                        <p>
                            <span aria-hidden="true">📍</span>
                            <span>
                                <%= project.address_text %>
                                <% if (project.commune) { %>
                                    — <%= project.commune %>
                                <% } %>
                                <% if (project.department) { %>
                                    (<%= project.department %>)
                                <% } %>
                            </span>
                        </p>

                        <p>
                            <span aria-hidden="true">💰</span>
                            <span>
                                Budget prévisionnel :
                                <% if (project.budget_estimate !== null && project.budget_estimate !== undefined) { %>
                                    <strong>
                                        <%= Number(project.budget_estimate).toLocaleString("fr-FR") %> FCFA
                                    </strong>
                                <% } else { %>
                                    Non renseigné
                                <% } %>
                            </span>
                        </p>

                        <p>
                            <span aria-hidden="true">📅</span>
                            <span>
                                Début :
                                <%= project.start_date
                                    ? new Date(project.start_date).toLocaleDateString("fr-FR", { timeZone: "UTC" })
                                    : "Non défini" %>
                            </span>
                        </p>

                        <p>
                            <span aria-hidden="true">🏁</span>
                            <span>
                                Fin prévue :
                                <%= project.target_end_date
                                    ? new Date(project.target_end_date).toLocaleDateString("fr-FR", { timeZone: "UTC" })
                                    : "Non définie" %>
                            </span>
                        </p>
                    </div>


                    <div class="chantier-progress">
                        <div class="chantier-progress-header">
                            <span>Avancement des travaux</span>
                            <strong><%= Number(project.progress_percentage ?? 0) %> %</strong>
                        </div>

                        <div
                            class="chantier-progress-track"
                            role="progressbar"
                            aria-label="Avancement du chantier <%= project.title %>"
                            aria-valuemin="0"
                            aria-valuemax="100"
                            aria-valuenow="<%= Number(project.progress_percentage ?? 0) %>"
                        >
                            <div
                                class="chantier-progress-fill"
                                style="width: <%= Number(project.progress_percentage ?? 0) %>%"
                            ></div>
                        </div>
                    </div>
                    <div class="chantier-card-actions">
                        <button
                            type="button"
                            class="btn-primary"
                            onclick="window.location.href='/chantiers/<%= project.id %>'">
                            Voir le chantier

                        </button>

                    </div>

                    <div class="chantier-card-footer">
                        <span>Créé le <%= new Date(project.created_at).toLocaleDateString("fr-FR") %></span>
                        <span class="chantier-id">N° <%= project.id %></span>
                    </div>
                </article>
            <% }); %>
        </div>
    <% } %>
        </div>
    </div>
</div>

<script>
(function () {
    const layout = document.getElementById('chantiers-layout');
    const toggle = document.getElementById('chantiers-sidebar-toggle');
    const label = toggle
        ? toggle.querySelector('.chantiers-sidebar-toggle-label')
        : null;

    if (!layout || !toggle) return;

    toggle.addEventListener('click', function () {
        const collapsed = layout.classList.toggle('is-collapsed');

        toggle.setAttribute('aria-expanded', String(!collapsed));
        toggle.setAttribute(
            'aria-label',
            collapsed
                ? 'Déplier le menu des chantiers'
                : 'Replier le menu des chantiers'
        );

        if (label) {
            label.textContent = collapsed
                ? 'Déplier le menu'
                : 'Replier le menu';
        }
    });
})();
</script>
