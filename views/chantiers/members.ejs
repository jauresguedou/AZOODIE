<div class="chantiers-page">
    <header class="chantiers-header">
        <div>
            <p class="chantiers-eyebrow">AZÔÔDIÉ · GESTION DES ACCÈS</p>
            <h1>Membres du chantier</h1>
            <p class="chantiers-subtitle">
                <%= project.title %>
            </p>
        </div>

        <button
            type="button"
            class="btn-secondary"
            onclick="window.location.href='/chantiers/<%= project.id %>'">
            Retour au chantier
        </button>
    </header>

    <section class="chantier-card">
        <h2>Inviter un utilisateur inscrit</h2>
        <p>
            L'utilisateur doit déjà posséder un compte AZÔÔDIÉ.
        </p>

        <form
            action="/chantiers/<%= project.id %>/invitations"
            method="POST"
            class="chantiers-form">
    <input type="hidden" name="_csrf" value="<%= constructionCsrfToken %>">

            <div class="form-group">
                <label for="email">Adresse e-mail du compte *</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    maxlength="320"
                    required
                    autocomplete="email"
                    placeholder="exemple@email.com">
            </div>

            <div class="form-group">
                <label for="member_role">Rôle *</label>
                <select id="member_role" name="member_role" required>
                    <option value="">Choisir un rôle</option>
                    <option value="site_manager">
                        Responsable du chantier — peut soumettre des rapports
                    </option>
                    <option value="viewer">
                        Lecteur — consultation uniquement
                    </option>
                </select>
            </div>

            <button type="submit" class="btn-primary">
                Envoyer l'invitation
            </button>
        </form>
    </section>

    <section class="chantier-dashboard-reports">
        <div class="chantier-dashboard-section-heading">
            <div>
                <p class="chantiers-eyebrow">ACCÈS AU PROJET</p>
                <h2>Membres et invitations</h2>
            </div>
        </div>

        <% if (!members || members.length === 0) { %>
            <article class="chantier-card chantier-dashboard-empty">
                <h3>Aucun membre invité</h3>
                <p>
                    Vous pourrez gérer les accès après avoir envoyé une invitation.
                </p>
            </article>
        <% } else { %>
            <div class="daily-reports-list">
                <% members.forEach(function(member) { %>
                    <article class="chantier-card">
                        <h3><%= member.name || member.email %></h3>

                        <p>
                            <strong>E-mail :</strong>
                            <%= member.email %>
                        </p>

                        <p>
                            <strong>Rôle :</strong>
                            <%= member.member_role === "site_manager"
                                ? "Responsable du chantier"
                                : "Lecteur" %>
                        </p>

                        <p>
                            <strong>État :</strong>
                            <% if (member.invitation_status === "pending") { %>
                                En attente de réponse
                            <% } else if (member.invitation_status === "accepted") { %>
                                Accès accepté
                            <% } else { %>
                                Accès révoqué
                            <% } %>
                        </p>

                        <% if (["pending", "accepted"].includes(member.invitation_status)) { %>
                            <form
                                action="/chantiers/<%= project.id %>/membres/<%= member.membership_id %>/revoquer"
                                method="POST"
                                onsubmit="return confirm('Révoquer cet accès à ce chantier ?');">
    <input type="hidden" name="_csrf" value="<%= constructionCsrfToken %>">
                                <button type="submit" class="btn-secondary">
                                    Révoquer l'accès
                                </button>
                            </form>
                        <% } %>
                    </article>
                <% }); %>
            </div>
        <% } %>
    </section>
</div>
