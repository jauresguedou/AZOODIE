<%
    const submittedValues = typeof formValues === "undefined" ? {} : formValues;
    const professionalCredentials =
        typeof credentials === "undefined" ? [] : credentials;
%>
<div class="form-container" style="margin-top: 32px;">
      <section class="professional-edit-card">
        <h1>Modifier le profil</h1>

        <%- include('../partials/messages', { errors }) %>

        <form action="/professionals/<%= professional.id %>/edit" method="POST" enctype="multipart/form-data">
             <div class="form-group">
                <label for="name">Nom</label>
                <input type="text" name="name" id="name" value="<%= submittedValues.name ?? professional.name %>" required>
             </div>
            
             <div class="form-group">
                <label for="trade_category">Métier</label>
                <input type="text" name="trade_category" id="trade_category" value="<%= submittedValues.trade_category ?? professional.trade_category%>" required>
             </div>

             <div class="form-group">
                <label for="service_radius_km">Rayon de service</label>
                <input type="number" name="service_radius_km" id="service_radius_km" value="<%= submittedValues.service_radius_km ?? professional.service_radius_km %>">
             </div>

             <div class="form-group nearby-location-field">
                <label for="address_input">Adresse</label>
                <div class="nearby-input-wrap">
                    <input type="text" id="address_input" value="<%= submittedValues.address_text ?? professional.address_text ?? '' %>" placeholder="Ex. : Cotonou, Fidjrossè..." autocomplete="off" required>
                    <div id="address_suggestions" class="nearby-suggestions"></div>
                </div>
                <input type="hidden" id="address_text" name="address_text" value="<%= submittedValues.address_text ?? professional.address_text ?? '' %>">
                <input type="hidden" id="base_lat" name="base_lat" value="<%= submittedValues.base_lat ?? professional.base_lat %>">
                <input type="hidden" id="base_lng" name="base_lng" value="<%= submittedValues.base_lng ?? professional.base_lng %>">
             </div>

             <div class="form-group">
                <label for="availability">Disponibilité</label>
                <select name="availability_status" id="availability_status">
                   <option value="available" <%= (submittedValues.availability_status ?? professional.availability_status) === 'available' ? 'selected' : ''%>>Disponible</option>
                   <option value="busy" <%= (submittedValues.availability_status ?? professional.availability_status) === 'busy' ? 'selected' : ''%>>Occupé</option>
                </select>
             </div>

             <div class="form-group">
                <label for="photo">Ajouter une photo de profil</label>
                <input type="file" id="photo" name="photo" accept="image/*"> 
             </div>

             <div class="profile-form-actions">
               <button type="submit" class="btn-primary">Enregistrer les modifications</button>
             </div>
        </form>
      </section>

                      
   <section class="credential-manager" id="professional-credentials">
      <div class="credential-manager-heading">
         <div class="credential-manager-icon" aria-hidden="true">
               <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <path d="M14 2v6h6"/>
                  <path d="m9 15 2 2 4-4"/>
               </svg>
         </div>
         <div>
               <h2>Documents & qualifications</h2>
               <p>Présentez vos diplômes, certifications ou assurances pour aider vos clients à mieux connaître votre expérience.</p>
         </div>
      </div>

      <div class="credential-optional-note">
         <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
               aria-hidden="true">
               <circle cx="12" cy="12" r="10"/>
               <path d="M12 11v5"/>
               <path d="M12 8h.01"/>
         </svg>
         <p>Cette étape est facultative. Vous pouvez utiliser AZÔÔDIÉ et recevoir des demandes sans ajouter de document. L’authenticité des documents fournis n’est pas vérifiée automatiquement.</p>
      </div>

      <form
         action="/professionals/<%= professional.id %>/credentials"
         method="POST"
         enctype="multipart/form-data"
         class="credential-upload-form"
      >
         <div class="form-group">
               <label for="credential_type">Type de document</label>
               <select name="credential_type" id="credential_type" required>
                  <option value="">Choisir un type</option>
                  <option value="certification">Certification</option>
                  <option value="insurance">Assurance professionnelle</option>
                  <option value="diploma">Diplôme</option>
                  <option value="professional_certificate">Certificat professionnel</option>
                  <option value="technical_diploma">Diplôme technique</option>
                  <option value="higher_education">Diplôme d’études supérieures</option>
                  <option value="safety_certificate">Certificat de sécurité</option>
               </select>
         </div>

         <div class="form-group">
               <label for="credential_title">Nom du document</label>
               <input
                  type="text"
                  name="title"
                  id="credential_title"
                  maxlength="150"
                  placeholder="Ex. : CAP Maçonnerie, CQM, assurance BTP..."
                  required
               >
         </div>

         <div class="form-group">
               <label for="issuing_body">Organisme émetteur <span>(facultatif)</span></label>
               <input
                  type="text"
                  name="issuing_body"
                  id="issuing_body"
                  placeholder="Ex. : établissement, centre de formation, assureur"
               >
         </div>

         <div class="form-group">
               <label for="expiry_date">Date d’expiration <span>(facultative)</span></label>
               <input type="date" name="expiry_date" id="expiry_date">
         </div>

         <div class="form-group">
               <label for="credential_document">Fichier du document</label>
               <div class="credential-file-input">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                        aria-hidden="true">
                     <path d="M12 16V4"/>
                     <path d="m7 9 5-5 5 5"/>
                     <path d="M20 16.5v2A2.5 2.5 0 0 1 17.5 21h-11A2.5 2.5 0 0 1 4 18.5v-2"/>
                  </svg>
                  <input
                     type="file"
                     name="document"
                     id="credential_document"
                     accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp"
                     required
                  >
               </div>
               <small>PDF, JPG, PNG ou WEBP — 10 Mo maximum.</small>
         </div>

         <button type="submit" class="btn-primary credential-submit">
               <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true">
                  <path d="M12 5v14"/>
                  <path d="M5 12h14"/>
               </svg>
               Ajouter le document
         </button>
      </form>



      <div class="credential-existing">
         <h3>Mes documents enregistrés</h3>

         <% if (professionalCredentials.length > 0) { %>
               <div class="credential-manager-list">
                  <% professionalCredentials.forEach(function(credential) { %>
                     <article class="credential-manager-card">
                           <div class="credential-manager-card-icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                 <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                 <path d="M14 2v6h6"/>
                                 <path d="M8 13h8M8 17h6"/>
                              </svg>
                           </div>

                           <div class="credential-manager-card-content">
                              <h4><%= credential.title %></h4>
                              <% if (credential.issuing_body) { %>
                                 <p><%= credential.issuing_body %></p>
                              <% } %>
                              <span class="credential-status">
                                 Document fourni — authenticité non vérifiée
                              </span>
                              <% if (credential.expiry_date) { %>
                                 <small>
                                       Expiration :
                                       <%= new Date(credential.expiry_date).toLocaleDateString("fr-FR", { timeZone: "UTC" }) %>
                                 </small>
                              <% } %>
                           </div>

                           <div class="credential-manager-actions">
                              <a
                                 href="<%= credential.document_url %>"
                                 target="_blank"
                                 rel="noopener noreferrer"
                                 class="credential-view-link"
                                 aria-label="Consulter le document : <%= credential.title %>"
                              >
                                 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                       stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                       aria-hidden="true">
                                       <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/>
                                       <circle cx="12" cy="12" r="3"/>
                                 </svg>
                                 Consulter
                              </a>

                              <form
                                 action="/professionals/<%= professional.id %>/credentials/<%= credential.id %>/delete"
                                 method="POST"
                                 onsubmit="return confirm('Supprimer ce document ?');"
                              >
                                 <button
                                       type="submit"
                                       class="credential-delete-button"
                                       aria-label="Supprimer le document : <%= credential.title %>"
                                 >
                                       <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                          stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                          aria-hidden="true">
                                          <path d="M3 6h18"/>
                                          <path d="M8 6V4h8v2"/>
                                          <path d="m19 6-1 14H6L5 6"/>
                                          <path d="M10 11v5M14 11v5"/>
                                       </svg>
                                       Supprimer
                                 </button>
                              </form>
                           </div>
                     </article>
                  <% }); %>
               </div>
         <% } else { %>
               <div class="credential-empty-state">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                        aria-hidden="true">
                     <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                     <path d="M14 2v6h6"/>
                     <path d="M8 13h8M8 17h5"/>
                  </svg>
                  <p>Aucun document ajouté pour le moment.</p>
                  <span>Vous pourrez en ajouter plus tard si vous le souhaitez.</span>
               </div>
         <% } %>
      </div>
   </section>





         <form action="/professionals/<%= professional.id%>/delete" method="POST" style="margin-top:12px;" onsubmit="return confirm('Supprimer définitivement ce profil ?');">
               <button type="submit" class="btn-primary" style="background:#C0392B;">Supprimer ce profil</button>
         </form>
      </div>
      <script src="/js/address-autocomplete.js"></script>
      <script>
         initAddressAutocomplete({
               inputId: "address_input",
               suggestionsId: "address_suggestions",
               latId: "base_lat",
               lngId: "base_lng",
               addressTextId: "address_text",
         });
      </script>
