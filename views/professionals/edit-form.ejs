<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/header', { title : 'Modifier ' + professional.name + ' — AZÔÔDIÉ'}) %>
</head>
<body>

    <%- include('../partials/nav') %>
    <div class="form-container" style="margin-top: 32px;">
        <h1>Modifier le profil</h1>

        <% if (errors.length > 0) { %>

         <div style="background: #FBE7E4; color:#C0392B; padding:12px; border-radius:10px; margin-bottom:16px; ">
            <ul style="margin:0; padding-left: 18px;">
                <% errors.forEach(function(err) { %>
                    <li><%= err.msg %></li>
                <%  }); %>

            </ul>
         </div> 
        <%  } %>

        <form action="/professionals/<%= professional.id %>/edit" method="POST" enctype="multipart/form-data">
             <div class="form-group">
                <label for="name">Nom</label>
                <input type="text" name="name" id="name" value="<%= professional.name %>" required>
             </div>
            
             <div class="form-group">
                <label for="trade_category">Métier</label>
                <input type="text" name="trade_category" id="trade_category" value="<%= professional.trade_category%>" required>
             </div>

             <div class="form-group">
                <label for="service_radius_km">Rayon de service</label>
                <input type="number" name="service_radius_km" id="service_radius_km" value="<%= professional.service_radius_km %>">
             </div>

             <div class="form-group">
                <label for="base_lat">Latitude</label>
                <input type="text" name="base_lat" id="base_lat" value="<%= professional.base_lat %>" required>
             </div>

             <div class="form-group">
                <label for="base_lng">Longitude</label>
                <input type="text" id="base_lng" name="base_lng" value="<%= professional.base_lng%>" required>
             </div>

             <div class="form-group">
                <label for="availability">Disponibilité</label>
                <select name="availability_status" id="availability_status">
                   <option value="available" <%= professional.availability_status === 'available' ? 'selected' : ''%>>Disponible</option>
                   <option value="busy" <%= professional.availability_status === 'busy' ? 'selected' : ''%>>Occupé</option>
                </select>
             </div>

             <div class="form-group">
                <label for="photo">Ajouter une photo</label>
                <input type="file" id="photo" name="photo" accept="image/*">
             
             </div>
             <button type="submit" class="btn-primary">Enregistrer les modifications</button>
        </form>

        <form action="/professionals/<%= professional.id%>/delete" method="POST" style="margin-top:12px;" onsubmit="return confirm('Supprimer définitivement ce profil ?');">
            <button type="submit" class="btn-primary" style="background:#C0392B;">Supprimer ce profil</button>
        </form>
    </div>

</body>
</html>