<% const submittedValues = typeof formValues === "undefined" ? {} : formValues; %>
<div class="form-container">

        

        <h1>Ajouter un Professionnel</h1>

         <%- include('../partials/messages', { errors: typeof errors === "undefined" ? [] : errors }) %>

       <form action="/professionals" method="POST">
           
            <div class="form-group">
               <label for="name">Nom</label>
               <input type="text" id="name" name="name" value="<%= submittedValues.name ?? '' %>" required>
            </div>
          
            
            <div class="form-group">
                <label for="trade_category">Métier</label>
                <input type="text" id="trade_category" name="trade_category" value="<%= submittedValues.trade_category ?? '' %>" required>
            </div>

            <div class="form-group">
                <label for="service_radius_km">Rayon de service</label>
                <input type="number" id="service_radius_km" name="service_radius_km" value="<%= submittedValues.service_radius_km ?? 15 %>">
            </div>

            <div class="form-group nearby-location-field">
                <label for="address_input">Adresse</label>
                <div class="nearby-input-wrap">
                    <input type="text" id="address_input" value="<%= submittedValues.address_text ?? '' %>" placeholder="Ex. : Cotonou, Fidjrossè..." autocomplete="off" required>
                    <div id="address_suggestions" class="nearby-suggestions"></div>
                </div>
                <input type="hidden" id="address_text" name="address_text" value="<%= submittedValues.address_text ?? '' %>">
                <input type="hidden" id="base_lat" name="base_lat" value="<%= submittedValues.base_lat ?? '' %>">
                <input type="hidden" id="base_lng" name="base_lng" value="<%= submittedValues.base_lng ?? '' %>">
            </div>

        
         <button type="submit" class="btn-primary">Enregistrer</button>

       </form>


    </div>
    <script src="/js/address-autocomplete.js"></script>
    <script>
        initAddressAutocomplete({
            inputId: "address_input",
            suggestionsId: "address_suggestions",
            latId: "base_lat",
            lngId: "base_lng",
            addressTextId: "address_text",
        });
    </script>
