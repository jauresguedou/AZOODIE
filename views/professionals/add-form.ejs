<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/header', {title: 'Ajouter un professionnel - AZÔÔDIÉ'}) %>
</head>
<body>

    <%- include('../partials/nav') %>

    <div class="form-container">

        

        <h1>Ajouter un Professionnel</h1>

         <% if (typeof errors !== "undefined" && errors.length > 0) { %>
            <div style="background:#FBE7E4; color:#C0392B; padding:12px; border-radius:10px; margin-bottom:16px;">
                <ul style="margin:0; padding-left:18px;">
                <% errors.forEach(function(err) { %>
                    <li><%= err.msg %></li>
                <% }); %>
                </ul>
            </div>
            <% } %>

       <form action="/professionals" method="POST">
           
            <div class="form-group">
               <label for="name">Nom</label>
               <input type="text" id="name" name="name" required>
            </div>
          
            
            <div class="form-group">
                <label for="trade_category">Métier</label>
                <input type="text" id="trade_category" name="trade_category" required>
            </div>

            <div class="form-group">
                <label for="service_radius_km">Rayon de service</label>
                <input type="number" id="service_radius_km" name="service_radius_km" value="15">
            </div>

            <div class="form-group">
                <label for="base_lat">Latitude</label>
                <input type="text" id="base_lat" name="base_lat" required>
            </div>
             
            <div class="form-group">
                <label for="base_lng">Longitude</label>
                <input type="text" id="base_lng" name="base_lng" required>
         
            </div>

        
         <button type="submit" class="btn-primary">Enregistrer</button>

       </form>


    </div>
    
</body>
</html>