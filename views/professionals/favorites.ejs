<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/header', {title: Mes favoris - AZÔÔDIÉ}) %>
</head>
<body>

    <%- include('../partials/nav') %>

    <div class="form-container">
        <h1>Mes favoris</h1>

        <% if (favorites.length === 0) { %>
            <p>Vous n'avez encore aucun professionnel favori.</p>
        <% } else { %>
            <% favorites.forEach(function(pro) { %>
                <div class="result-card">
                    <div>
                        <strong><a href="/professionals/<%= pro.id %>" style="color:var(--dark); text-decoration:none;"><%= pro.name %></a></strong> — <%= pro.trade_category %>
                    </div>
                </div>
            <% }); %>
        <% } %>

        <a href="/professionals" class="btn-primary" style="display:inline-block; text-decoration:none; text-align:center; margin-top:16px;">Retour à la liste</a>
    </div>

</body>
</html>