
<div class="form-container professionals-directory">

    <h1>Professionnels enregistrés</h1>
   
<div class="professional-search">
    <label for="professionalSearch" class="sr-only">
        Rechercher un professionnel par son nom
    </label>

    <span class="professional-search-icon" aria-hidden="true">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M5 21v-2a7 7 0 0 1 14 0v2"></path>
        </svg>
    </span>

    <input
        type="search"
        id="professionalSearch"
        placeholder="Rechercher un professionnel par son nom..."
        autocomplete="off"
        aria-label="Rechercher un professionnel par son nom"
    />

    <span class="professional-search-submit-icon" aria-hidden="true">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
        </svg>
    </span>
</div>

<p
    id="professionalSearchStatus"
    class="professional-search-status"
    aria-live="polite"
></p>

<script src="/js/professional-search.js" defer></script>






























    <div class="professionals-grid">

        <% professionals.forEach(function(pro) { %>

            <article class="professional-card">

                <a
                    class="professional-card-photo"
                    href="/professionals/<%= pro.id %>"
                    aria-label="Voir le profil de <%= pro.name %>"
                >
                    <%
                        const photos = Array.isArray(pro.photo_urls)
                            ? pro.photo_urls.filter(
                                url => typeof url === "string" && url.trim() !== ""
                            )
                            : [];

                        const photoUrl = photos.length > 0
                            ? photos[photos.length - 1]
                            : "/images/default-avatar.svg";
                    %>

                    <img
                        src="<%= photoUrl %>"
                        alt="Photo de <%= pro.name %>"
                        loading="lazy"
                        onerror="this.onerror=null; this.src='/images/default-avatar.png';"
                    >
                </a>

                <div class="professional-card-info">

                    <h2>
                        <a href="/professionals/<%= pro.id %>">
                            <%= pro.name %>
                        </a>
                    </h2>

                    <p class="professional-card-trade">
                        <%= pro.trade_category || "Professionnel" %>
                    </p>

                    <a
                        class="professional-contact-button"
                        href="/requests/new/<%= pro.id %>"
                    >
                        Contacter
                    </a>

                </div>

            </article>

        <% }); %>

    </div>

    

</div>
