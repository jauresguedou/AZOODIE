<div class="form-container">

        <h1>Professionnels enregistrés</h1>

        <% professionals.forEach(function(pro) { %>

            <div class="form-group">
                <strong><a href="/professionals/<%= pro.id %>" style="color:var(--dark); text-decoration:none;"><%= pro.name %></a></strong> — <%= pro.trade_category %>
                <br>
                <small><%= pro.base_lat %>, <%= pro.base_lng %> . Rayon: <%= pro.service_radius_km %> km</small>
            </div>

       <% }); %>
       <a href="/professionals/add" class="btn-primary" style="display:inline-block; text-decoration:none; text-align:center; margin-top:12px;">Ajouter un Professionel</a>
    </div>
