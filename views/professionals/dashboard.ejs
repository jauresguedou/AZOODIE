<div class="form-container" style="max-width:720px;">
    <h1>Tableau de bord</h1>
    <p>
        Bienvenue, <strong><%= professional.name %></strong>.
        Voici les demandes ouvertes dans votre rayon de service.
    </p>

    <section aria-labelledby="nearby-leads-heading">
        <h2 id="nearby-leads-heading" style="font-family:var(--font-heading); color:var(--teal);">
            <%= leadCount %> demande<%= leadCount === 1 ? '' : 's' %> à proximité
        </h2>

        <% if (recentLeads.length === 0) { %>
            <p>Aucune demande ouverte dans votre zone pour le moment.</p>
        <% } else { %>
            <% recentLeads.forEach(function(lead) { %>
                <article class="result-card">
                    <div>
                        <strong><%= lead.category %></strong>
                        <p><%= lead.description %></p>
                        <small><%= lead.address_text %></small>
                    </div>
                    <span class="distance-chip"><%= Number(lead.distance_km).toFixed(1) %> km</span>
                </article>
            <% }); %>
        <% } %>
    </section>

    <a href="/professionals/leads" class="btn-primary" style="display:block; text-align:center; text-decoration:none; margin-top:20px;">
        Voir toutes les demandes
    </a>
    <a href="/professionals/<%= professional.id %>/edit" class="btn-primary" style="display:block; text-align:center; text-decoration:none; background:var(--dark); margin-top:12px;">
        Modifier mon profil
    </a>
</div>