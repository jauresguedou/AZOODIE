<%
    const profilePhoto = Array.isArray(professional.photo_urls) && professional.photo_urls.length > 0
        ? professional.photo_urls[professional.photo_urls.length - 1]
        : null;
    const rating = Number(professional.rating_avg || 0);
    const reviewCount = Number(professional.review_count || 0);
    const isOwner = Number(session.professionalId) === Number(professional.id);
%>
<div class="professional-profile-page">
    <section class="professional-profile-card" aria-labelledby="professional-profile-name">
        <div class="professional-profile-cover" aria-hidden="true">
            <span>AZÔÔDIÉ · PROFESSIONNELS</span>
        </div>

        <div class="professional-profile-identity">
            <div class="professional-profile-avatar">
                <% if (profilePhoto) { %>
                    <img src="<%= profilePhoto %>" alt="Photo de <%= professional.name %>">
                <% } else { %>
                    <span aria-hidden="true"><%= professional.name.trim().charAt(0).toLocaleUpperCase("fr-FR") %></span>
                <% } %>
            </div>

            <div class="professional-profile-main">
                <div class="professional-profile-heading">
                    <div>
                        <p class="professional-profile-eyebrow">Professionnel du bâtiment</p>
                        <h1 id="professional-profile-name"><%= professional.name %></h1>
                        <p class="professional-profile-trade"><%= professional.trade_category %></p>
                        <div class="professional-profile-badges">
                            <% if (professional.verified) { %>
                                <span class="professional-profile-badge professional-profile-verified">
                                    <span aria-hidden="true">✓</span> Profil vérifié
                                </span>
                            <% } %>
                            <span class="professional-profile-badge <%= professional.availability_status === 'available' ? 'professional-profile-available' : 'professional-profile-busy' %>">
                                <span aria-hidden="true"></span>
                                <%= professional.availability_status === "available" ? "Disponible" : "Occupé" %>
                            </span>
                        </div>
                    </div>

                    <% if (isOwner) { %>
                        <a class="professional-profile-edit" href="/professionals/<%= professional.id %>/edit">Modifier le profil</a>
                    <% } %>
                </div>

                <div class="professional-profile-actions">
                    <a href="/requests/new/<%= professional.id %>" class="professional-profile-contact">Contacter</a>
                </div>
            </div>
        </div>
    </section>
    
    <%
        const profileCredentials = typeof credentials !== "undefined" && Array.isArray(credentials)
            ? credentials
            : [];
    %>

    <section class="professional-profile-section professional-profile-credentials"
             aria-labelledby="professional-profile-credentials-title">
        <div class="professional-profile-credentials-heading">
            <div class="professional-profile-credentials-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M7 3.5h7l5 5V20a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 20V5A1.5 1.5 0 0 1 6.5 3.5H7Z"
                          stroke="currentColor" stroke-width="1.7"
                          stroke-linejoin="round"/>
                    <path d="M14 3.8V9h5M8 13h8M8 16.5h6"
                          stroke="currentColor" stroke-width="1.7"
                          stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>

            <div class="professional-profile-credentials-title-wrap">
                <p class="professional-profile-eyebrow">Confiance & transparence</p>
                <h2 id="professional-profile-credentials-title">
                    Documents & qualifications
                </h2>
                <p class="professional-profile-muted">
                    Consultez les justificatifs partagés par ce professionnel.
                </p>
            </div>
        </div>

        <% if (profileCredentials.length > 0) { %>
            <div class="professional-profile-credentials-list">
                <% profileCredentials.forEach((credential) => { %>
                    <article class="professional-profile-credential">
                        <div class="professional-profile-credential-file-icon" aria-hidden="true">
                            <% if (credential.credential_type === "insurance") { %>
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M12 3 19 6v5c0 4.6-2.8 8-7 10-4.2-2-7-5.4-7-10V6l7-3Z"
                                          stroke="currentColor" stroke-width="1.7"
                                          stroke-linejoin="round"/>
                                    <path d="m9 12 2 2 4-4"
                                          stroke="currentColor" stroke-width="1.7"
                                          stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            <% } else { %>
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M3 9.5 12 4l9 5.5-9 5.5-9-5.5Z"
                                          stroke="currentColor" stroke-width="1.7"
                                          stroke-linejoin="round"/>
                                    <path d="M7 12v4.5c3.2 2.5 6.8 2.5 10 0V12M21 9.5V15"
                                          stroke="currentColor" stroke-width="1.7"
                                          stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            <% } %>
                        </div>

                        <div class="professional-profile-credential-details">
                            <h3><%= credential.title %></h3>

                            <p>
                                <%= ({
                                    certification: "Certification",
                                    insurance: "Assurance professionnelle",
                                    diploma: "Diplôme",
                                    professional_certificate: "Certificat professionnel",
                                    technical_diploma: "Diplôme technique",
                                    higher_education: "Études supérieures",
                                    safety_certificate: "Certificat de sécurité"
                                })[credential.credential_type] || "Document professionnel" %>
                            </p>

                            <% if (credential.issuing_body) { %>
                                <span class="professional-profile-credential-issuer">
                                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M3 21h18M5 21V8l7-4 7 4v13M9 11h.01M15 11h.01M9 15h.01M15 15h.01M10 21v-3h4v3"
                                              stroke="currentColor" stroke-width="1.6"
                                              stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <%= credential.issuing_body %>
                                </span>
                            <% } %>

                            <% if (credential.expiry_date) { %>
                                <span class="professional-profile-credential-expiry">
                                    Expire le
                                    <%= new Date(credential.expiry_date).toLocaleDateString("fr-FR") %>
                                </span>
                            <% } %>

                            <span class="professional-profile-credential-status">
                                <span aria-hidden="true">●</span>
                                Document fourni — authenticité non vérifiée
                            </span>
                        </div>

                        <a class="professional-profile-credential-view"
                           href="<%= credential.document_url %>"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Consulter le document : <%= credential.title %>">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M14 3h7v7M21 3l-10 10M19 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h6"
                                      stroke="currentColor" stroke-width="1.7"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>Consulter</span>
                        </a>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <div class="professional-profile-credentials-empty">
                <div class="professional-profile-credentials-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M7 3.5h7l5 5V20a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 20V5A1.5 1.5 0 0 1 6.5 3.5H7Z"
                              stroke="currentColor" stroke-width="1.7"
                              stroke-linejoin="round"/>
                        <path d="M14 3.8V9h5M8 13h8M8 16.5h5"
                              stroke="currentColor" stroke-width="1.7"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div>
                    <h3>Aucun document ajouté pour le moment</h3>
                    <p>
                        Ce professionnel peut exercer sur AZÔÔDIÉ sans justificatif.
                        Les diplômes, certificats et autres documents sont facultatifs
                        et permettent de renforcer la confiance des clients.
                    </p>
                    <% if (isOwner) { %>
                        <a class="professional-profile-credential-add"
                           href="/professionals/<%= professional.id %>/edit#professional-credentials">
                            <span aria-hidden="true">＋</span>
                            Ajouter un document
                        </a>
                    <% } %>
                </div>
            </div>
        <% } %>

        <% if (isOwner && profileCredentials.length > 0) { %>
            <a class="professional-profile-credential-manage"
               href="/professionals/<%= professional.id %>/edit#professional-credentials">
                Gérer mes documents <span aria-hidden="true">→</span>
            </a>
        <% } %>
    </section>


    <div class="professional-profile-columns">
        <div class="professional-profile-content">
            <section class="professional-profile-section professional-profile-feed" aria-labelledby="professional-profile-portfolio-title">
                <div class="professional-profile-feed-heading">
                    <div>
                        <p class="professional-profile-eyebrow">Réalisations</p>
                        <h2 id="professional-profile-portfolio-title">Portfolio</h2>
                    </div>
                </div>

                <% if (isOwner) { %>
                    <form class="professional-profile-composer" action="/professionals/<%= professional.id %>/portfolio" method="POST" enctype="multipart/form-data">
                        <label for="portfolio-caption">Partagez une réalisation</label>
                        <textarea id="portfolio-caption" name="caption" maxlength="500" placeholder="Décrivez votre projet, les matériaux utilisés ou le résultat obtenu..." rows="3"></textarea>
                        <div class="professional-profile-composer-actions">
                            <label class="professional-profile-media-picker" for="portfolio-media">
                                <span aria-hidden="true">＋</span> Ajouter une photo ou une vidéo
                            </label>
                            <input id="portfolio-media" type="file" name="media" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime" required>
                            <button type="submit" class="professional-profile-contact">Publier</button>
                        </div>
                        <p class="professional-profile-upload-hint">Images JPEG, PNG ou WebP, vidéos courtes MP4, WebM ou MOV (40 Mo max.).</p>
                    </form>
                <% } %>

                <% if (typeof portfolioPosts !== "undefined" && portfolioPosts.length > 0) { %>
                    <div class="professional-profile-posts">
                        <% portfolioPosts.forEach((post) => { %>
                            <article class="professional-profile-post">
                                <header class="professional-profile-post-header">
                                    <div class="professional-profile-post-avatar" aria-hidden="true"><%= professional.name.trim().charAt(0).toLocaleUpperCase("fr-FR") %></div>
                                    <div class="professional-profile-post-author">
                                        <strong><%= professional.name %></strong>
                                        <time datetime="<%= new Date(post.created_at).toISOString() %>"><%= new Date(post.created_at).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" }) %></time>
                                    </div>
                                    <% if (isOwner) { %>
                                        <form action="/professionals/<%= professional.id %>/portfolio/<%= post.id %>/delete" method="POST">
                                            <button type="submit" class="professional-profile-post-delete" aria-label="Supprimer cette publication">Supprimer</button>
                                        </form>
                                    <% } %>
                                </header>
                                <% if (post.caption) { %>
                                    <p class="professional-profile-post-caption"><%= post.caption %></p>
                                <% } %>
                                <% if (post.media_type === "video") { %>
                                    <video class="professional-profile-post-media" controls playsinline preload="metadata">
                                        <source src="<%= post.media_url %>">
                                        Votre navigateur ne prend pas en charge la lecture vidéo.
                                    </video>
                                <% } else { %>
                                    <img class="professional-profile-post-media" src="<%= post.media_url %>" alt="Réalisation de <%= professional.name %>" loading="lazy">
                                <% } %>
                            </article>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="professional-profile-muted professional-profile-empty-portfolio">
                        <% if (isOwner) { %>
                            Vos réalisations apparaîtront ici. Publiez votre premier projet pour présenter votre savoir-faire.
                        <% } else { %>
                            Aucune réalisation publiée pour le moment.
                        <% } %>
                    </p>
                <% } %>
            </section>

            <section class="professional-profile-section professional-profile-rating-section">
                <p class="professional-profile-eyebrow">Avis clients</p>
                <h2>Évaluations</h2>
                <% if (reviewCount > 0) { %>
                    <div class="professional-profile-rating">
                        <span class="professional-profile-rating-number"><%= rating.toFixed(1) %></span>
                        <div>
                            <span class="professional-profile-stars" aria-label="Note de <%= rating.toFixed(1) %> sur 5">
                                <% for (let star = 1; star <= 5; star += 1) { %>
                                    <span aria-hidden="true"><%= rating >= star ? "★" : "☆" %></span>
                                <% } %>
                            </span>
                            <p>Basé sur <%= reviewCount %> avis</p>
                        </div>
                    </div>
                <% } else { %>
                    <p class="professional-profile-muted">Aucun avis pour le moment.</p>
                <% } %>
            </section>
        </div>

        <aside class="professional-profile-sidebar" aria-label="Informations sur le professionnel">
            <section class="professional-profile-section professional-profile-facts">
                <p class="professional-profile-eyebrow">Informations</p>
                <h2>Services</h2>
                <div class="professional-profile-fact">
                    <span class="professional-profile-fact-icon" aria-hidden="true">⌖</span>
                    <div>
                        <strong>Zone d’intervention</strong>
                        <span>Dans un rayon de <%= professional.service_radius_km %> km</span>
                    </div>
                </div>
                <div class="professional-profile-fact">
                    <span class="professional-profile-fact-icon" aria-hidden="true">✦</span>
                    <div>
                        <strong>Métier</strong>
                        <span><%= professional.trade_category %></span>
                    </div>
                </div>
            </section>

            <a href="/professionals" class="professional-profile-back">← Retour aux professionnels</a>
        </aside>
    </div>
</div>
