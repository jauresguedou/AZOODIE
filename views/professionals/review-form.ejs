<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/header', { title: 'Évaluer ' + professional.name + ' — AZÔÔDIÉ' }) %>
</head>
<body>

    <div class="form-container" style="margin-top:32px;">
        <h1><%= existingReview ? 'Modifier mon avis' : 'Laisser un avis' %></h1>
        <p><%= professional.name %> — <%= professional.trade_category %></p>

        <% if (errors.length > 0) { %>
          <div style="background:#FBE7E4; color:#C0392B; padding:12px; border-radius:10px; margin-bottom:16px;">
            <ul style="margin:0; padding-left:18px;">
              <% errors.forEach(function(err) { %><li><%= err %></li><% }); %>
            </ul>
          </div>
        <% } %>

        <form action="/professionals/<%= professional.id %>/review" method="POST">
            <div class="form-group">
                <label>Note</label>
                <div class="star-rating">
                    <% [5, 4, 3, 2, 1].forEach(function(n) { %>
                        <input type="radio" id="star<%= n %>" name="rating" value="<%= n %>" <%= existingReview && existingReview.rating === n ? 'checked' : '' %> required>
                        <label for="star<%= n %>">★</label>
                    <% }); %>
                </div>
            </div>

            <div class="form-group">
                <label for="comment">Commentaire (optionnel)</label>
                <textarea id="comment" name="comment" rows="4" maxlength="1000" style="font-family:var(--font-body); font-size:1rem; padding:10px 14px; border:1px solid var(--gray-light); border-radius:10px; background:var(--gray-bg);"><%= existingReview ? existingReview.comment : '' %></textarea>
            </div>

            <button type="submit" class="btn-primary"><%= existingReview ? 'Mettre à jour mon avis' : 'Publier mon avis' %></button>
        </form>
    </div>

</body>
</html>