<% const submittedValues = typeof formValues === "undefined" ? {} : formValues; %>
<div class="form-container">
        <h1>Contacter <%= professional.name %></h1>

        <%- include('../partials/messages', { errors }) %>
        <p><%= professional.trade_category %> . <%= professional.service_radius_km %> km de rayon</p>

        <form action="/requests" method="POST">
            <input type="hidden" name="professional_id" value="<%= professional.id %>">

            <div class="form-group">
                <label for="category"> Categories </label>
                <input type="text" id="category" name="category" value="<%= submittedValues.category ?? professional.trade_category %>" required>

            </div>

            <div class="form-group">
                <label for="description">Description de la demande</label>
                <input type="text" id="description" name="description" value="<%= submittedValues.description ?? '' %>" required>


            </div>
            <div class="form-group nearby-location-field">
                <label for="address_input">Lieu du chantier</label>
                <div class="nearby-input-wrap">
                    <input type="text" id="address_input" value="<%= submittedValues.address_text ?? '' %>" placeholder="Ex. : Cotonou, Fidjrossè..." autocomplete="off" required>
                    <div id="address_suggestions" class="nearby-suggestions"></div>
                </div>
                <input type="hidden" id="address_text" name="address_text" value="<%= submittedValues.address_text ?? '' %>">
                <input type="hidden" id="lat" name="lat" value="<%= submittedValues.lat ?? '' %>">
                <input type="hidden" id="lng" name="lng" value="<%= submittedValues.lng ?? '' %>">
            </div>

            <div class="form-group">
                   <label for="budget_estimate"> Budget estimé (optionel)</label>
                   <input type="number" id="budget_estimate" name="budget_estimate" value="<%= submittedValues.budget_estimate ?? '' %>">
            </div>

            <button type="submit" class="btn-primary">Envoyer la demande</button>


        </form>

    </div>
    <script src="/js/address-autocomplete.js"></script>
    <script>
        initAddressAutocomplete({
            inputId: "address_input",
            suggestionsId: "address_suggestions",
            latId: "lat",
            lngId: "lng",
            addressTextId: "address_text",
        });
    </script>
