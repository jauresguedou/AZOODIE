<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Contacter <%= professional.name %> - AZÔÔDIÉ</title>
</head>
<body>
    <div class="form-container">
        <h1>Contacter <%= professional.name %></h1>
        <p><%= professional.trade_category %> . <%= professional.service_radius_km %> km de rayon</p>

        <form action="/requests" method="POST">
            <input type="hidden" name="professional_id" value="<%= professional.id %>">

            <div class="form-group">
                <label for="category"> Categories </label>
                <input type="text" id="category" name="category" value="<%= professional.trade_category %>" required>  

            </div>

            <div class="form-group">
                <label for="description">Description de la demande</label>
                <input type="text" id="description" name="description" required>


            </div>
            
            <div class="form-group"> 
                <label for="lat">Latitude</label>
                <input type="text" id="lat" name="lat" required>
            </div>

            <div class="form-group">
                 <label for="lng">Longitude</label>
                 <input type="text" id="lng" name="lng" required>

            </div>

            <div class="form-group">
                   <label for="budget_estimate"> Budget estimé (optionel)</label>
                   <input type="number" id="budget_estimate" name="budget_estimate">
            </div>

            <button type="submit" class="btn-primary">Envoyer la demande</button>


        </form>

    </div>
    
</body>
</html>