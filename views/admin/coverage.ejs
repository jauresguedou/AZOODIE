<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/header', { title : 'Couverture géographique -  AZÔÔDIÉ '}) %>
</head>
<body>

    <%- include('../partials/nav') %>

    <div class="form-container" style="margin-top: 32px; max-width: 800px;">
           <h1>Couverture géographique</h1>
           <p style="color:var(--gray);">Zones triées par déséquilibre demande/offre (pires en premier)</p>

           <% if (zones.length === 0) { %>
                <p>Aucune demande ouverte pour le moment.</p>

            <%  } else {  %>
                <table style="width:100%; border-collapse:collapse; margin-top:16px;">
                    <thead>
                        <tr style="text-align: left; border-bottom: 2px solid var(--gray-light);">
                              <th style="padding:10px;">Zone (lat, lng)</th>
                              <th style="padding:10px;">Demandes ouvertes</th>
                              <th style="padding:10px;">Professionnels disponibles</th>
                              <th style="padding:10px;">Ratio</th>

                        </tr>

                    </thead>
                    <tbody>
                        <% zones.forEach(function(zone) {  %>
                            <tr style="border-bottom: 1px solid var(--gray-light);">
                                <td style="padding:10px;"><%= zone.zone_lat %>, <%= zone.zone_lng %></td>
                                <td style="padding:10px;"><%= zone.request_count %></td>
                                <td style="padding:10px;"><%= zone.professional_count %></td>
                                <td style="padding:10px;">
                                    <span class="distance-chip" style="background: <%= zone.professional_count == 0 ? '#C0392B' : 'var(--teal)' %>;">
                                       <%= zone.professional_count == 0 ? 'Aucune couverture': (zone.request_count + ':' + zone.professional_count)%> 
                                    </span> 
                                </td>



                            </tr>
                        <%  }); %>
                        
                    </tbody>
                </table>
            <%   }  %>
    </div>
    
</body>
</html>