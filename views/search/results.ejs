<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/header', { title: 'Recherche — AZÔÔDIÉ' })%>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/js/search.js"></script>
    <title>Recherche — AZÔÔDIÉ</title>
</head>
<body>


    <%- include('../partials/nav') %>

    <div class="form-container">
        <h1>Professionnels près de vous</h1>
        <div class="form-group" id="location-form" style="margin-bottom:20px; position: relative;">
            <label for="location-input">Votre position</label>
            <input type="text" id="location-input" placeholder="Entrez une adresse à Cotonou..." autocomplete="off">
            <div id="suggestions" style="position:absolute; top:100%; left:0; right:0; background:#fff; border:1px solid var(--gray-light); border-radius:10px; margin-top:4px; z-index:10; display:none;"></div>
        </div>

        <% if (searched) {%>
        <form  method="GET" action="/search" id="filter-form">
           <input type="hidden" name="lat" value="<%= lat %>">
           <input type="hidden" name="lng" value="<%= lng %>">
           
           <div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;">
              <div class="form-group" style="flex:1; min-width: 140px; margin-bottom:0" >
                <label for="category" >Métier</label>
                <select name="category" id="category" onchange="document.getElementById('filter-form').submit()">
                   <option value="">Tous</option>
                   <% tradeCategories.forEach(function(group) {%>
                       <optgroup label="<%= group.label%>">
                       
                       
                       <% group.trades.forEach(function(trade) {%>
                        
                          <option value="<%= trade%> <%= filters.category === trade ? 'selected' : ''%>"><%= trade %></option>

                       <%  }); %>
                       </optgroup>
                  
                  <% }); %>
                </select>

              </div>
           
           
           
           </div>
        </form>
        <% }%>

        <% if (searched && professionals.length > 0) { %>
            <div class="toggle-group">
                <button type="button" id="btn-list" class="toggle-btn active">Liste</button>
                <button type="button" id="btn-map" class="toggle-btn">Carte</button>
            </div>
        <% } %>

        <% if (!searched) { %>
            <p>Indiquez votre position pour voir les professionnels à proximité.</p>

        <% } else if (professionals.length === 0) { %>
            <p>Aucun professionnel disponible dans cette zone pour le moment.</p>

        <% } else { %>
            <div id="list-view">
                <% professionals.forEach(function(pro) { %>
                    <div class="result-card">
                        <div>
                            <strong><%= pro.name %></strong> — <%= pro.trade_category %>
                            <br>
                            <small>Rayon: <%= pro.service_radius_km %> km</small>
                        </div>
                        <div class="distance-chip">
                            <%= pro.distance_km.toFixed(1) %> km
                        </div>
                    </div>
                <% }); %>
            </div>

            <div id="map-view" style="display:none;">
                <div id="map"></div>
            </div>
        <% } %>
    </div>

    <% if (searched && professionals.length > 0) { %>
        <script>
            window.AZOODIE_SEARCH = {
                clientLat: <%- lat %>,
                clientLng: <%- lng %>,
                professionals: <%- JSON.stringify(professionals) %>
            };
        </script>
        <script src="/js/map.js"></script>
    <% } %>

</body>
</html>