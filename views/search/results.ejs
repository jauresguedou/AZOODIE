<div class="nearby-page">
    <header class="nearby-heading">
        <p class="nearby-eyebrow">AZÔÔDIÉ · Trouvez le bon professionnel</p>
        <h1>Des professionnels près de vous</h1>
        <p>Comparez les professionnels disponibles autour de votre adresse.</p>
    </header>

    <section class="nearby-search-panel" aria-label="Rechercher par adresse">
        <div class="nearby-search-copy">
            <span class="nearby-location-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="2.5"></circle>
                </svg>
            </span>
            <div>
                <h2>Où avez-vous besoin d’aide ?</h2>
                <p>Choisissez une adresse pour voir les professionnels disponibles à proximité.</p>
            </div>
        </div>
        <div class="form-group nearby-location-field" id="location-form">
            <label for="location-input">Entrez votre adresse ou votre quartier</label>
            <div class="nearby-input-wrap">
                <input type="text" id="location-input" placeholder="Ex. : Cotonou, Fidjrossè..." autocomplete="off">
                <button type="button" id="search-location-button" class="nearby-search-button" aria-label="Rechercher cette adresse" title="Rechercher cette adresse">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="10.8" cy="10.8" r="6.8"></circle>
                        <path d="m16 16 4.5 4.5"></path>
                    </svg>
                </button>
                <div id="suggestions" class="nearby-suggestions"></div>
            </div>
            <p id="location-search-status" class="nearby-search-status" role="status" aria-live="polite"></p>
        </div>
    </section>

    <% if (searched) { %>
        <form method="GET" action="/search" id="filter-form" class="nearby-filter-panel">
            <input type="hidden" name="lat" value="<%= lat %>">
            <input type="hidden" name="lng" value="<%= lng %>">
            <input type="hidden" name="category" id="selected-category" value="<%= filters.category || '' %>">
            <div class="nearby-filter-heading">
                <div>
                    <span class="nearby-eyebrow">Affiner les résultats</span>
                    <h2>Filtres</h2>
                </div>
                <% if (filters.category) { %>
                    <a class="nearby-clear-filter" href="/search?lat=<%= encodeURIComponent(lat) %>&amp;lng=<%= encodeURIComponent(lng) %>">Effacer le métier</a>
                <% } %>
            </div>
            <div class="nearby-trade-picker">
                <button type="button"
                    id="trade-picker-toggle"
                    class="nearby-trade-picker-toggle"
                    aria-expanded="false"
                    aria-controls="trade-picker-panel">
                    <span class="nearby-trade-picker-label">
                        <span class="nearby-trade-picker-caption">Métier</span>
                        <strong id="trade-picker-value"><%= filters.category || "Tous les métiers" %></strong>
                    </span>
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m6 9 6 6 6-6"></path>
                    </svg>
                </button>
                <div id="trade-picker-panel" class="nearby-trade-picker-panel" hidden>
                    <div class="nearby-trade-categories">
                        <% tradeCategories.forEach(function(group) { %>
                            <details class="nearby-trade-category" <%= group.trades.includes(filters.category) ? "open" : "" %>>
                                <summary>
                                    <span><%= group.label %></span>
                                    <span class="nearby-category-count"><%= group.trades.length %></span>
                                </summary>
                                <div class="nearby-trade-list">
                                    <% group.trades.forEach(function(trade, index) { %>
                                        <button type="button"
                                            class="nearby-trade-option <%= filters.category === trade ? 'selected' : '' %>"
                                            data-trade="<%= trade %>"
                                            aria-pressed="<%= filters.category === trade ? 'true' : 'false' %>"
                                            <%= index >= 10 ? "hidden" : "" %>>
                                            <%= trade %>
                                        </button>
                                    <% }); %>
                                </div>
                                <% if (group.trades.length > 10) { %>
                                    <nav class="nearby-trade-pagination" aria-label="Pages des métiers : <%= group.label %>">
                                        <button type="button" class="nearby-trade-page-button" data-page-direction="-1" disabled>Précédent</button>
                                        <span class="nearby-trade-page-status" aria-live="polite">Page 1 sur <%= Math.ceil(group.trades.length / 10) %></span>
                                        <button type="button" class="nearby-trade-page-button" data-page-direction="1">Suivant</button>
                                    </nav>
                                <% } %>
                            </details>
                        <% }); %>
                    </div>
                </div>
            </div>
        </form>
    <% } %>

    <% if (!searched) { %>
        <section class="nearby-empty nearby-empty-start">
            <span class="nearby-empty-symbol" aria-hidden="true">⌖</span>
            <h2>Commencez par votre quartier</h2>
            <p>Entrez une adresse ci-dessus, puis sélectionnez une suggestion pour découvrir les professionnels autour de vous.</p>
        </section>
    <% } else if (professionals.length === 0) { %>
        <section class="nearby-empty">
            <span class="nearby-empty-symbol" aria-hidden="true">⌕</span>
            <h2>Aucun professionnel trouvé pour le moment</h2>
            <p>Essayez un autre quartier ou effacez le filtre métier pour élargir votre recherche.</p>
            <% if (filters.category) { %>
                <a class="nearby-secondary-link" href="/search?lat=<%= encodeURIComponent(lat) %>&amp;lng=<%= encodeURIComponent(lng) %>">Voir tous les métiers</a>
            <% } %>
        </section>
    <% } else { %>
        <section class="nearby-results" aria-labelledby="nearby-results-heading">
            <div class="nearby-results-heading">
                <div>
                    <p class="nearby-eyebrow">Votre sélection</p>
                    <h2 id="nearby-results-heading"><%= professionals.length %> professionnel<%= professionals.length === 1 ? "" : "s" %> disponible<%= professionals.length === 1 ? "" : "s" %></h2>
                    <p>Les plus proches de votre position</p>
                </div>
                <div class="nearby-view-switch" role="group" aria-label="Mode d’affichage">
                    <button type="button" id="btn-list" class="nearby-view-button active" aria-pressed="true">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                            <path d="M9 6h11M9 12h11M9 18h11"></path><path d="M4 6h.01M4 12h.01M4 18h.01"></path>
                        </svg>
                        Liste
                    </button>
                    <button type="button" id="btn-map" class="nearby-view-button" aria-pressed="false">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
                            <path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3z"></path><path d="M9 3v15M15 6v15"></path>
                        </svg>
                        Carte
                    </button>
                </div>
            </div>

            <div class="nearby-result-layout">
                <div id="list-view" class="nearby-professional-list">
                    <% professionals.forEach(function(pro) { %>
                        <article class="nearby-professional-card">
                            <a class="nearby-professional-avatar" href="/professionals/<%= pro.id %>" aria-label="Voir le profil de <%= pro.name %>">
                                <% if (Array.isArray(pro.photo_urls) && pro.photo_urls.length > 0) { %>
                                    <img src="<%= pro.photo_urls[0] %>" alt="">
                                <% } else { %>
                                    <span aria-hidden="true"><%= pro.name.trim().charAt(0).toLocaleUpperCase("fr-FR") %></span>
                                <% } %>
                            </a>
                            <div class="nearby-professional-info">
                                <div class="nearby-professional-title">
                                    <h3><a href="/professionals/<%= pro.id %>"><%= pro.name %></a></h3>
                                    <% if (pro.verified) { %>
                                        <span class="nearby-verified" title="Profil vérifié" aria-label="Profil vérifié">✓</span>
                                    <% } %>
                                </div>
                                <p class="nearby-professional-trade"><%= pro.trade_category %></p>
                                <div class="nearby-professional-meta">
                                    <span class="nearby-rating"><span aria-hidden="true">★</span> <%= Number(pro.rating_avg || 0).toFixed(1) %> <span class="nearby-review-count">(<%= pro.review_count || 0 %> avis)</span></span>
                                    <span class="nearby-meta-dot" aria-hidden="true">·</span>
                                    <span><%= Number(pro.distance_km).toFixed(1) %> km de vous</span>
                                </div>
                            </div>
                            <a class="nearby-contact-link" href="/requests/new/<%= pro.id %>">Voir le profil</a>
                        </article>
                    <% }); %>
                </div>
                <%- include("map") %>
            </div>
        </section>
    <% } %>
</div>

<% if (searched && professionals.length > 0) { %>
    <script>
        window.AZOODIE_SEARCH = <%- searchData %>;
    </script>
    <script src="/js/map.js"></script>
<% } %>
<% if (searched) { %>
    <script src="/js/trade-pagination.js" defer></script>
<% } %>
